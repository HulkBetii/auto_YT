  "nhan_vat_chinh": {
    "id": "nhan_vat_chinh",
    "name": "Nữ Chính (Minh Hà)",
    "role": "Nữ Chính Khổ Hạnh & Kiên Cường",
    "engine": "vieneu",
    "voice": "Ngọc Linh",
    "style": "tu_nhien",
    "temperature": 0.8,
    "top_p": 0.95,
    "top_k": 25,
    "use_ref_codes": true,
    "ref_audio": "C:\\Users\\HulkBeoti\\Downloads\\nu-chinh.mp3",
    "ref_text": "Tôi chưa từng nghĩ tám năm đồng cam cộng khổ lại kết thúc bằng một sự phản bội trơ trẽn như thế này. Nhưng anh hãy nhớ cho kỹ, những gì thuộc về mồ hôi nước mắt của tôi và gia đình tôi, tôi sẽ lấy lại không thiếu một đồng!",
    "speed": 0.96,
    "f0_baseline": 193.1,
    "desc": "Giọng nữ chuẩn Hà Nội, nghẹn ngào, nén đau thương, dứt khoát và đanh thép khi lật màn."
  },
  "bo_chong": {
    "id": "bo_chong",
    "name": "Bố Chồng / Cựu Binh Già",
    "role": "Nam Cao Tuổi Khắc Khổ & Bản Lĩnh",
    "engine": "vieneu",
    "voice": "Thanh Bình",
    "style": "tu_nhien",
    "temperature": 0.78,
    "top_p": 0.95,
    "top_k": 25,
    "use_ref_codes": true,
    "ref_audio": "C:\\Users\\HulkBeoti\\Downloads\\bo-chong.mp3",
    "ref_text": "Tôi là Nguyễn Đức Cần, Đại tá Quân đội Nhân dân Việt Nam đã về hưu. Ba mươi năm tôi cầm súng bảo vệ Tổ quốc, không một lần khuất phục trước kẻ thù. Các anh có thể lấy đi căn nhà của tôi, nhưng không ai có thể lấy đi phẩm giá của người lính trong tôi.",
    "speed": 0.92,
    "f0_baseline": 130.0,
    "desc": "Giọng nam lớn tuổi miền Bắc clone từ bo-chong.mp3, trầm đục, từng trải, nén nỗi xót xa nhưng uy nghiêm đĩnh đạc của cựu binh."
  },
  "me_gia": {
    "id": "me_gia",
    "name": "Mẹ Già Quê Nghèo",
    "role": "Nữ Cao Tuổi Tần Tảo & Nghẹn Ngào",
    "engine": "vieneu",
    "voice": "Mai Anh",
    "style": "tu_nhien",
    "temperature": 0.82,
    "top_p": 0.95,
    "top_k": 25,
    "use_ref_codes": true,
    "ref_audio": "C:\\Users\\HulkBeoti\\Downloads\\me-chong.mp3",
    "ref_text": "Mẹ gom góp từng củ khoai nhánh rau cả một đời chỉ mong con ăn học nên người. Giờ con có nhà cao cửa rộng, mẹ đâu dám xin gì nhiều, chỉ mong một góc nhỏ để nhìn con cháu mạnh khỏe thôi mà con...",
    "speed": 0.92,
    "f0_baseline": 185.0,
    "desc": "Giọng nữ lớn tuổi miền quê, khắc khổ, rung rẩy nghẹn ngào, giàu tình mẫu tử bao la."
  },
  "nguoi_chong": {
    "id": "nguoi_chong",
    "name": "Người Chồng Cựu Binh",
    "role": "Nam Trung Niên Cương Trực & Phong Trần",
    "engine": "vieneu",
    "voice": "Phạm Tuyên",
    "style": "tu_nhien",
    "temperature": 0.79,
    "top_p": 0.95,
    "top_k": 25,
    "use_ref_codes": true,
    "ref_audio": "C:\\Users\\HulkBeoti\\Downloads\\nguoi-chong.mp3",
    "ref_text": "Năm năm nơi đầu sóng ngọn gió, tôi chắt chiu từng đồng gửi về xây dựng tổ ấm. Tôi không ngờ sự hy sinh của mình lại bị chà đạp bởi lòng tham và sự phản bội trơ trẽn đến mức này!",
    "speed": 0.95,
    "f0_baseline": 135.0,
    "desc": "Giọng nam trung niên miền Bắc, dứt khoát, phong trần, đậm chất kỷ luật người lính."
  },
  "me_chong": {
    "id": "me_chong",
    "name": "Mẹ Chồng (Bà Lý)",
    "role": "Mẹ Chồng Cay Nghiệt",
    "engine": "vieneu",
    "voice": "Mai Anh",
    "style": "tu_nhien",
    "temperature": 0.85,
    "top_p": 0.95,
    "top_k": 25,
    "use_ref_codes": true,
    "ref_audio": "C:\\Users\\HulkBeoti\\Downloads\\me-chong.mp3",
    "ref_text": "Tôi nói để chị biết nhé, cái loại cau điếc tám năm trời không đẻ nổi một mụn con nối dõi thì lấy tư cách gì làm dâu nhà này? Chị dọn đồ ra khỏi đây ngay trong đêm nay, đừng có ở lại làm chướng mắt mẹ con tôi!",
    "speed": 1.0,
